{
  "name": "wsl-shadow",
  "version": "0.1.0",
  "description": "Shows which program an AI agent will run for node, npm, bun and friends under WSL, compared with your terminal.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": "./dist/report.v1.schema.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "wsl-shadow": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/index.js",
    "dist/*.d.ts",
    "dist/report.v1.schema.json",
    "README.md",
    "LICENSE",
    "skill"
  ],
  "engines": {
    "node": ">=18",
    "bun": ">=1.1.0"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "bun x tsc",
    "build": "bun build src/cli.ts --outfile dist/cli.js --target node && bun build src/index.ts --outfile dist/index.js --target node && bun x tsc -p tsconfig.build.json && bun run scripts/copy-schema.ts",
    "build:bin": "bun run build:bin:x64 && bun run build:bin:arm64",
    "build:bin:x64": "bun build src/cli.ts --compile --target=bun-linux-x64 --outfile dist/wsl-shadow-linux-x64",
    "build:bin:arm64": "bun build src/cli.ts --compile --target=bun-linux-arm64 --outfile dist/wsl-shadow-linux-arm64",
    "prepublishOnly": "bun run typecheck && bun test && bun run build"
  },
  "keywords": [
    "wsl",
    "wsl2",
    "path",
    "agents",
    "npm",
    "diagnostics",
    "mcp",
    "nodejs"
  ],
  "license": "AGPL-3.0-only",
  "author": "Augusto Cerrutti (https://github.com/kanchingyg)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kanchingyg/wsl-shadow.git"
  },
  "bugs": "https://github.com/kanchingyg/wsl-shadow/issues",
  "homepage": "https://github.com/kanchingyg/wsl-shadow#readme",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "bun-types": "^1.4.4",
    "typescript": "5.8.3"
  }
}
